{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\ud83d\udc3a \u5c0f\u72fc\u7684\u5b9e\u9a8c\u5ba4","text":"<p>\u201c\u53ea\u505a\u81ea\u5df1\u559c\u6b22\u7684\u4e8b\u201d \u2014\u2014\u2014\u2014 \u96c4\u9f99ztz</p> <p>\u4f60\u597d\uff0c\u964c\u751f\u4eba\uff0c\u521d\u6b21\u89c1\u9762\uff0c\u8bf7\u591a\u5173\u7167\u3002</p>"},{"location":"#_2","title":"\ud83d\udc3e \u5173\u4e8e\u6211","text":"<p>\u6211\u7684\u5708\u540d\u53eb\u201c\u96c4\u9f99ztz\u201d\uff0c\u4f46\u6211\u5728\u7f51\u7edc\u4e0a\u4e60\u60ef\u4f7f\u7528\u201c\u5c0f\u72fc\u201d\u8fd9\u4e2a\u66f4\u4eb2\u8fd1\u7684\u79f0\u547c\u3002\u4e3a\u4e86\u65b9\u4fbf\u4ea4\u6d41\uff0c\u4f60\u53ef\u4ee5\u7528\u8fd9\u4e2a\u66f4\u4eb2\u8fd1\u7684\u79f0\u547c\u6765\u79f0\u547c\u6211\u3002</p> <p>\u6211\u4e8e2002\u5e741\u670811\u65e5\u51fa\u751f\uff0c\u7b80\u5355\u6765\u8bf4\uff0c\u6211\u662f\u4e00\u4e2a\u5174\u8da3\u5e7f\u6cdb\u3001\u601d\u7ef4\u6d3b\u8dc3\u3001\u5bcc\u6709\u521b\u9020\u529b\u548c\u6280\u672f\u70ed\u60c5\u7684\u4eba\u3002</p> <p>\u6211\u7684MBTI\u662fINTJ\u578b\uff0c\u5bf9\u4e8e\u6027\u53d6\u5411\u65b9\u9762\u7684\u95ee\u9898\u6211\u6682\u4e14\u4fdd\u5bc6\uff0c\u6709\u5c0f\u4f17\u800c\u5e7f\u6cdb\u7684\u7231\u597d\uff0c\u5728\u4e0b\u6587\u4f1a\u5c55\u5f00\u8bf4\u660e\u3002</p> <p>\u6211\u53ef\u80fd\u662f\u4e00\u4e2a\u8868\u9762\u770b\u4e0a\u53bb\u9ad8\u51b7\uff0c\u4f46\u5b9e\u9645\u4e0a\u5185\u5fc3\u975e\u5e38\u6e34\u671b\u53d7\u5230\u5173\u6ce8\u7684\u4eba\u3002</p> <p>\u6211\u7684\u7cbe\u795e\u72b6\u6001\u53ef\u80fd\u4e0d\u662f\u5f88\u597d\uff0c\u4e0d\u5e0c\u671b\u53d7\u5230\u523a\u6fc0\uff0c\u6211\u4e5f\u4e0d\u5e0c\u671b\u770b\u5230\u53d1\u751f\u5728\u8eab\u8fb9\u7684\u60b2\u5267\u3002</p>"},{"location":"#_3","title":"\ud83d\udcbb \u5df2\u638c\u63e1\u7684\u6280\u80fd","text":"<p>\u6b63\u5982\u6211\u524d\u9762\u6240\u8ff0\uff0c\u6211\u662f\u4e00\u4e2a\u5177\u6709\u6280\u672f\u70ed\u60c5\u7684\u4eba\u3002\u867d\u7136\u6211\u4f1a\u7684\u4e1c\u897f\u4e0d\u662f\u5f88\u591a\uff0c\u4f46\u662f\u6211\u6709\u5728\u5b66\u4e60\uff1a</p> <ol> <li>\u7f16\u7a0b</li> <li>Visual Basic .NET \u2014\u2014\u2014\u2014 \u8fd9\u662f\u6211\u6700\u64c5\u957f\u7684\u9886\u57df\uff0c\u867d\u7136\u5982\u4eca\u5df2\u7ecf\u663e\u5f97\u8fc7\u65f6\uff0c\u4f46\u5b83\u4ecd\u7136\u662f\u6211\u5982\u4eca\u6700\u62ff\u624b\u7684\u4e00\u95e8\u7f16\u7a0b\u8bed\u8a00\u3002\u4f60\u53ef\u4ee5\u5728GitHub\u4e0a\u770b\u5230\u6211\u5f00\u6e90\u7684\u9879\u76ee\u3002</li> <li>Java \u2014\u2014\u2014\u2014 \u6211\u4e8e 2025 \u5e74\u5b66\u4e60\uff0c\u6700\u521d\u4e3a\u4e86\u5f00\u53d1\u6211\u7684\u4e16\u754c (Minecraft) \u670d\u52a1\u5668\u63d2\u4ef6\u800c\u5b66\u3002\u4f60\u53ef\u4ee5\u5728Modrinth\u6216MineBBS\u4e0a\u770b\u5230\u6211\u5f00\u53d1\u7684\u90e8\u5206\u670d\u52a1\u5668\u63d2\u4ef6\u3002</li> <li>Python \u2014\u2014\u2014\u2014 \u4e8e\u672c\u79d1\u65f6\u671f\u8ba1\u7b97\u673a\u8bfe\u8bbe\u81ea\u5b66\u8fc7\uff0c\u6709\u4e00\u5b9a\u7684\u4e86\u89e3\uff0c\u4f46\u662f\u4e0d\u662f\u5f88\u6df1\u5165\u7814\u7a76\u3002</li> <li>C \u2014\u2014\u2014\u2014 \u4e8e\u672c\u79d1\u65f6\u671f\u5b66\u4e60\uff0c\u6709\u4e00\u5b9a\u7684\u4e86\u89e3\uff0c\u4f46\u5bf9\u4e8e\u66f4\u52a0\u6df1\u5165\u7684\u5b66\u4e60\u4e86\u89e3\u7684\u7a0d\u5fae\u5c11\u4e00\u4e9b\u3002</li> <li>\u89c6\u9891\u5236\u4f5c</li> <li>Bilibili \u2014\u2014\u2014\u2014 \u6211\u662f\u89c6\u9891\u7f51\u7ad9\u54d4\u54e9\u54d4\u54e9\u7684\u4e00\u4f4dUP\u4e3b\uff0c\u89c6\u9891\u98ce\u683c\u591a\u6837\uff1a\u6db5\u76d6\u6e38\u620f\uff0c\u97f3\u4e50\uff0c\u9b3c\u755c\u7b49\u591a\u4e2a\u9886\u57df\u3002</li> <li>Vegas Pro 14 Edit \u2014\u2014\u2014\u2014 \u6211\u7684\u7b2c\u4e00\u6b3e\u89c6\u9891\u526a\u8f91\u5de5\u5177\uff0c\u4e5f\u662f\u6211\u6700\u64c5\u957f\u7684\u89c6\u9891\u526a\u8f91\u5de5\u5177\u3002</li> <li>\u786c\u4ef6</li> <li>Verilog \u2014\u2014\u2014\u2014 \u6211\u5bf9FPGA/CPLD\u786c\u4ef6\u63cf\u8ff0\u8bed\u8a00\u6709\u6240\u4e86\u89e3\u3002</li> <li>MCU \u2014\u2014\u2014\u2014 \u6211\u5bf951\u5355\u7247\u673a/\u5fae\u63a7\u5236\u5668\u7684\u5f00\u53d1\u6709\u8f83\u4e3a\u6df1\u5165\u7684\u4e86\u89e3\u3002</li> <li>\u6a21\u62df\u7535\u8def \u2014\u2014\u2014\u2014 \u5bf9\u4e8e\u5f31\u7535\uff0c\u5c0f\u90e8\u5206\u673a\u7535\u9886\u57df\uff0c\u52a8\u529b\u7535\u5b50\u7b49\u9886\u57df\u6709\u4e00\u5b9a\u7684\u4e86\u89e3\uff0c\u5bf9\u7535\u8def\u5177\u6709\u4e00\u5b9a\u7684\u8c03\u8bd5\u80fd\u529b\u3002\u4f60\u53ef\u4ee5\u5728\u7acb\u521b\u5f00\u6e90\u5e73\u53f0\u4e0a\u770b\u5230\u6211\u5f00\u6e90\u7684\u90e8\u5206\u9879\u76ee\u3002</li> <li>\u6570\u5b57\u7535\u8def \u2014\u2014\u2014\u2014 \u5bf9\u4e8e\u63a7\u5236\u7535\u8def\u6709\u4e00\u5b9a\u7684\u4e86\u89e3\u3002</li> <li>\u6587\u5b66\u521b\u4f5c</li> <li>Pixiv \u2014\u2014\u2014\u2014 \u6211\u5728\u52aa\u529b\u521b\u4f5c\u5c5e\u4e8e\u6211\u4e2a\u4eba\u4e16\u754c\u89c2\u7684\u6545\u4e8b\u96c6\u3002\u529b\u6c42\u6211\u7684 Furry \u8bbe\u5b9a\u53d8\u5f97\u66f4\u52a0\u5b8c\u6574</li> <li>\u5176\u4ed6</li> <li>\u6570\u636e\u5206\u6790\u4e0e\u6574\u7406 \u2014\u2014\u2014\u2014 \u64c5\u957f\u5904\u7406\u5404\u7c7b\u6587\u6863\uff0c\u6587\u4ef6\u3002</li> <li>\u670d\u52a1\u5668\u8fd0\u7ef4 \u2014\u2014\u2014\u2014 \u5bf9\u8ba1\u7b97\u673a\u7cfb\u7edf\u3001\u7f51\u7edc\u67b6\u6784\u6709\u4e00\u5b9a\u7684\u4e86\u89e3\uff0c\u53ef\u6392\u67e5\u90e8\u5206\u57fa\u7840\u95ee\u9898\u3002</li> <li>Photoshop \u2014\u2014\u2014\u2014 \u6211\u5e38\u5e38\u7528\u6765\u5236\u4f5c\u89c6\u9891\u5c01\u9762\u4e0e\u7b80\u5355\u7684\u56fe\u7247\u5904\u7406\uff0c\u4ee5\u53ca\u90e8\u5206\u7b80\u5355\u7684\u9700\u6c42\u3002</li> </ol>"},{"location":"#_4","title":"\ud83d\udd2d \u6b63\u5728\u5b66\u4e60\u7684\u6280\u80fd","text":"<p>\u4ee5\u4e0b\u662f\u6211\u529b\u6c42\u5b8c\u7f8e\uff0c\u6b63\u5728\u52aa\u529b\u5b66\u4e60\u548c\u6269\u5c55\u7684\u6280\u672f\u9886\u57df\uff1a</p> <ol> <li>\u7f16\u66f2</li> <li>FL Studio \u2014\u2014\u2014\u2014 \u6211\u5e0c\u671b\u80fd\u591f\u201c\u9a7e\u9a6d\u201d\u8fd9\u4e2a\u91ce\u517d\uff0c\u521b\u4f5c\u5c5e\u4e8e\u81ea\u5df1\u7684\u97f3\u4e50\u98ce\u683c\u3002</li> <li>VOCALOID \u2014\u2014\u2014\u2014 \u6211\u60f3\u8981\u5b66\u4e60V\u5bb6/\u672f\u529b\u53e3\u66f2\u7684\u521b\u4f5c\uff08\u6ce8\uff1a\u6b64\u5904\u7684<code>V\u5bb6</code>\u4e13\u6307<code>VOCALOID</code>\u800c\u4e0d\u662f\u5982\u4eca\u7684<code>VTuber</code>\uff09\u3002</li> <li>Adobe Audition \u2014\u2014\u2014\u2014 \u5b83\u5bf9\u4e8e\u97f3\u9891\u7f16\u8f91\u6709\u7740\u91cd\u8981\u4f5c\u7528</li> <li>\u5efa\u6a21</li> <li>Solidworks \u2014\u2014\u2014\u2014 \u5b83\u57283D\u6253\u5370\u9886\u57df\u7684\u5e94\u7528\u975e\u5e38\u5e7f\u6cdb\u3002</li> <li>Blender \u2014\u2014\u2014\u2014 \u5f88\u591a\u6e38\u620f\u5f00\u53d1\u8005\u90fd\u5728\u4f7f\u7528\u5b83\u3002</li> <li>\u7ed8\u753b</li> <li>PaintToolSAI \u2014\u2014\u2014\u2014 \u6700\u521d\u7684\u6211\u5e0c\u671b\u521b\u4f5c\u4e8c\u6b21\u5143\u4f5c\u54c1\uff0c\u5982\u4eca\u7684\u6211\u5e0c\u671b\u521b\u4f5cFurry\u7c7b\u578b\u7684\u4f5c\u54c1\uff08\u6ce8\uff1a\u6b64\u5904\u7684<code>\u4e8c\u6b21\u5143</code>\u4e0d\u5305\u542b\u4efb\u4f55\u8d2c\u4e49\u6210\u5206\uff09\u3002</li> <li>Aseprite \u2014\u2014\u2014\u2014 \u8fd9\u662f\u4e00\u4e2a\u50cf\u7d20\u98ce\u683c\u7684\u521b\u4f5c\u5de5\u5177\u3002</li> <li>\u6e38\u620f\u5f00\u53d1</li> <li>Unity3D \u2014\u2014\u2014\u2014 \u7edd\u5927\u591a\u6570\u4e2a\u4eba\u6216\u4f01\u4e1a\u5f00\u53d1\u8005\u9009\u62e9\u7684\u6e38\u620f\u5f15\u64ce\u3002</li> <li>Godot Engine \u2014\u2014\u2014\u2014 \u65b0\u5174\u7684\u6e38\u620f\u5f15\u64ce\u3002</li> <li>RPG Maker \u2014\u2014\u2014\u2014 \u5728\u5c06\u6765\uff0c\u6211\u53ef\u80fd\u4f1a\u4f7f\u7528\u5b83\u5236\u4f5c\u5267\u60c5\u7c7b\u6e38\u620f\uff0c\u53ef\u80fd\u53c2\u8003\u50cf\u662fThe Lar\u8fd9\u6837\u7684\u4f5c\u54c1\u53bb\u8bbe\u8ba1\u3002</li> <li>\u73b0\u5b9e\u6280\u80fd</li> <li>\u6e38\u6cf3 \u2014\u2014\u2014\u2014 \u4e00\u76f4\u5f88\u60f3\u53bb\u5c1d\u8bd5\u4f46\u4ecd\u7136\u6ca1\u6709\u8fdb\u884c\u5b9e\u9645\u4ed8\u51fa\u3002</li> <li>\u7ef3\u827a \u2014\u2014\u2014\u2014 \u611f\u53d7\u72ec\u7279\u7684\u7f8e\u611f\u3002</li> <li>\u5176\u4ed6</li> <li>\u524d\u7aef\u4e09\u5251\u5ba2(<code>HTML</code> + <code>JavaScript</code> + <code>CSS</code>) \u2014\u2014\u2014\u2014 \u867d\u7136\u6211\u5e76\u4e0d\u559c\u6b22\u524d\u7aef\uff0c\u6211\u66f4\u503e\u5411\u4e8e WinAPI\uff0c\u4f46\u662f\u8fd9\u53ef\u80fd\u662f\u6211\u4e3a\u6570\u4e0d\u591a\u59a5\u534f\u7684\u65f6\u523b\u3002</li> <li>Kotlin \u2014\u2014\u2014\u2014 \u8fdb\u519b\u5b89\u5353\u5f00\u53d1\u9886\u57df\u3002</li> <li>C# \u2014\u2014\u2014\u2014 \u4f5c\u4e3a Visual Basic .NET \u7684\u66f4\u5148\u8fdb\u7684\u66ff\u4ee3\uff0c\u5e76\u4e14\u5728\u6e38\u620f\u5f00\u53d1\u4e0a\u4f3c\u4e4e\u4e5f\u80fd\u7528\u5f97\u5230\u3002</li> <li>\u667a\u80fd\u4f53\u5de5\u7a0b \u2014\u2014\u2014\u2014 \u5c1d\u8bd5\u8bbe\u8ba1\u548c\u5b66\u4e60\u66f4\u7cfb\u7edf\u7684\u9879\u76ee\u3002</li> <li>CTF \u2014\u2014\u2014\u2014 \u7cfb\u7edf\u7684\u5b66\u4e60\uff0c\u6df1\u5165\u4e86\u89e3\u7f51\u7edc\u5b89\u5168\u9886\u57df\u7684\u77e5\u8bc6\u70b9\u3002</li> <li>CrackMe \u2014\u2014\u2014\u2014 \u5bf9\u64cd\u4f5c\u7cfb\u7edf\u7684\u6df1\u5165\u4e86\u89e3\uff0c\u5bf9\u8f6f\u4ef6\u7684\u9006\u5411\uff0c\u6c47\u7f16\uff0c\u6ce8\u5165\u7b49\u77e5\u8bc6\u7684\u7efc\u5408\u5b66\u4e60\uff0c\u5b66\u4e60\u5982<code>x64Dbg</code>\uff0c<code>OllyDbg</code>\uff0c<code>IDA</code>\u7b49\u5de5\u5177\u7684\u4f7f\u7528\u7528\u6cd5\u3002</li> <li>Linux \u2014\u2014\u2014\u2014 \u4e0d\u5c40\u9650\u4e8e<code>Windows</code>\u5e73\u53f0\uff0c\u800c\u662f\u5c06\u81ea\u5df1\u7684\u80fd\u529b\u6269\u5c55\u5230Linux</li> <li>VScode \u2014\u2014\u2014\u2014 \u5176\u4f59\u751f\u4ea7\u529b\u5de5\u5177\u7684\u4f7f\u7528\u65b9\u6cd5</li> </ol>"},{"location":"#_5","title":"\u2728 \u70ed\u7231\u7684\u4e8b\u7269","text":"<p>\u6211\u662f\u4e00\u4e2a\u5174\u8da3\u5e7f\u6cdb\u7684\u4eba\uff0c\u6211\u6709\u7740\u6211\u70ed\u7231\u7684\u90a3\u4e9b\uff0c\u4e0d\u7ba1\u662f\u7269\u8d28\u4e0a\uff0c\u8fd8\u662f\u7cbe\u795e\u4e0a\u7684\u4e8b\u7269\uff1a</p> <p>TODO:\u8fd9\u91cc\u6709\u540e\u7eed\u53ef\u80fd\u8981\u8865\u5145\u7684\u5185\u5bb9</p> <ol> <li>\u72ec\u7acb\u6e38\u620f</li> <li>\u5546\u4e1a\u6e38\u620f</li> <li>\u756a\u5267</li> <li>\u97f3\u4e50</li> <li>\u4e13\u8f91\u6536\u85cf</li> <li>Furry/\u517d\u4eba\u63a7\u6587\u5316</li> <li>\u53ef\u7231\u7684\u4e8b\u7269</li> </ol>"},{"location":"#_6","title":"\ud83d\udcde \u8054\u7cfb\u65b9\u5f0f","text":"<p>\u5982\u6709\u4e8b\u52a1\u9700\u8054\u7cfb\uff0c\u6b22\u8fce\u901a\u8fc7\u90ae\u4ef6\u4e0e\u6211\u4ea4\u6d41\uff1a\u53d1\u9001\u90ae\u4ef6</p>"}]}